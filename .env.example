# AVA Server Configuration
WS_HOST=0.0.0.0
WS_PORT=8765

# Ollama LLM
OLLAMA_MODEL=llama3.2:1b
OLLAMA_URL=http://localhost:11434

# Whisper STT
WHISPER_MODEL=base
STT_LANGUAGE=en

# Edge TTS
TTS_VOICE=en-IN-NeerjaNeural

# Audio
SAMPLE_RATE=16000

# WebSocket
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=10

# Call limits
CALL_MAX_DURATION=180

# Campaign
CAMPAIGN_DELAY=30
CAMPAIGN_MAX_RETRIES=3

# Database
DB_FILE=leads.db